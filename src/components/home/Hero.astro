---
import { Image } from 'astro:assets';
import HeroImage from '../../assets/images/pages/home/rex-publishing-corp-home-hero-image.png';
---
<div class="relative">
    			<div class="absolute inset-0 bg-black opacity-40"></div>
    			<div class="absolute 2xl:items-end 2xl:mb-40 inset-0 flex mt-10 md:mt-0 md:items-center justify-center">
        			<div class="a text-center">
            			<h1 class="mb-8 md:mb-10 text-5xl px-2 font-extrabold md:text-5xl xl:text-8xl text-gray-200">
Let’s Publish <br /> Your Story
            			</h1>
            			<p class="py-4 mb-8 md:mb-10 block font-light text-white px-2 md:px-56 lg:mb-8 text-xl md:text-lg lg:text-2xl xl:px-24 xl:mb-20 2xl:w-3/5 xl:mx-auto">
              From Manuscript to Masterpiece - Rex Publishing is Your Trusted Publishing Partner. Publish Your Book With Us to eBook or Audiobook.	
            			</p>
            			<div class="flex flex-wrap items-center justify-center md:flex-row md:flex-nowrap">
                			<a
                            title="Contact Us - Your Trusted Publishing Partner"
                					href="/contact/"
                            class="focus:outline-none text-white border border-white bg-whc-orange-400 hover:bg-teal-700 focus:ring-4 focus:ring-dibby-red-300 font-normal text-lg md:text-xl px-10 py-3 md:py-6 mx-8 md:mb-2 mb-4 md:w-auto w-3/4"
                            data-form-id="53b9c836-7122-4d0a-8a12-4d14197a384c"
                            data-form-name="Contact Us"
                			>
                            Contact Us
                			</a>

                			<a
                            title="Rex Publishing News"
                            href="/blog/"
                            class="text-white bg-teal-900 border border-teal-950 hover:bg-teal-700 focus:outline-none focus:ring-4 focus:ring-dibby-red-300 font-medium text-lg md:text-xl px-10 py-3 md:py-6 md:mr-8 mb-2 md:w-auto w-3/4"
                			>
                            Latest News
                			</a>
            			</div>
        			</div>
    			</div>
    			<Image 
        			class="w-full h-screen object-cover md:h-screen xl:h-screen" 
        			src={HeroImage} 
        			loading="eager" 
        			alt="Rex Publishing - Your Trusted Publishing Partner"
        			widths={[320, 480, 768, 1024, 1440, 1920, HeroImage.width]}
        			sizes={`100vw`}
          />
			</div>
