---
import { getCanonicalPath, getPublishedEntries } from '../../lib/reviews';

const posts = (await getPublishedEntries()).slice(0, 3);
---
<section class="bg-white ">
  <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
    <div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
      <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-teal-900 ">Our Latest Updates</h2>
      <p class="font-light text-teal-800 sm:text-xl ">Publishing news, reviews, and practical guidance from Rex Publishing.</p>
    </div>

    {posts.length ? (
      <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
        {posts.map((post) => (
          <article class="p-4 bg-white rounded-lg border border-gray-200 shadow-md">
            {post.data.heroImage && (
              <a href={getCanonicalPath(post)}>
                <img
                  class="mb-5 rounded-lg mx-auto h-[400px] w-full object-cover"
                  src={post.data.heroImage}
                  alt={post.data.description}
                  loading="lazy"
                />
              </a>
            )}
            <span class="bg-teal-800 text-teal-100 text-xs font-semibold mr-2 px-2.5 py-0.5 rounded ">
              {post.data.pubDate.toLocaleDateString()}
            </span>
            <h2 class="my-2 text-2xl font-bold tracking-tight text-teal-900 ">
              <a href={getCanonicalPath(post)}>{post.data.title}</a>
            </h2>
            <p class="mb-4 font-light text-teal-900 ">{post.data.description}</p>
          </article>
        ))}
      </div>
    ) : (
      <div class="mx-auto max-w-2xl rounded-2xl border border-teal-100 bg-teal-50 p-8 text-center">
        <h3 class="mb-3 text-2xl font-bold text-teal-900">No updates published yet</h3>
        <p class="text-teal-800">
          Fresh articles and reviews will appear here once they are published.
        </p>
      </div>
    )}
  </div>
</section>
