---
import { Image } from 'astro:assets';
import Logo1 from '../../assets/images/pages/home/WhereWeAre/1.webp';
import Logo2 from '../../assets/images/pages/home/WhereWeAre/2.webp';
import Logo3 from '../../assets/images/pages/home/WhereWeAre/libby-logo.png';
import Logo4 from '../../assets/images/pages/home/WhereWeAre/Amazon-Logo.png';
import Logo5 from '../../assets/images/pages/home/WhereWeAre/Barnes-Noble-Logo.png';
---
<section class="bg-white">
    <div class="py-8 lg:py-16 mx-auto max-w-screen-xl px-4">
        <h2 class="mb-8 lg:mb-16 text-3xl font-extrabold tracking-tight leading-tight text-center text-teal-900 md:text-4xl">Where We Are</h2>
        <div class="grid grid-cols-2 gap-8 text-teal-800 sm:gap-12 md:grid-cols-3 lg:grid-cols-5 ">
            <a href="#" class="flex justify-center items-center">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={Logo1} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
            </a>
            <a href="#" class="flex justify-center items-center">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={Logo2} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
            </a>
            <a href="#" class="flex justify-center items-center">
              <Image class="mr-4 w-auto h-20 md:w-auto md:h-32 rounded-lg" src={Logo3} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
            </a>

            <a href="#" class="flex justify-center items-center">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={Logo4} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
            </a>
            <a href="#" class="flex justify-center items-center">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={Logo5} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
            </a>
        </div>
    </div>
</section>
