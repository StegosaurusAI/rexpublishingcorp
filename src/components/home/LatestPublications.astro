---
import { Image } from 'astro:assets';
import ImagePublication1 from '../../assets/images/pages/home/unlock-the-power-of-generative-ai-in-seo.jpg';
---
 <section class="bg-teal-950">
  <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      <div class="text-center text-gray-900">
          <h2 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 lg:text-5xl text-white">Our Latest Publications</h2>
      </div>
      <div class="grid gap-6 mt-12 lg:mt-14 lg:gap-12 md:grid-cols-3">
          <div class="flex mb-2 md:flex-col md:mb-0">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={ImagePublication1} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
              <div>
                  <h3 class="text-xl font-bold md:mt-4 mb-2.5 text-gray-900 text-white">Unlock The Power of Generative AI in SEO by Andrew Bus</h3>
                  <p class="text-gray-200">This book, written by an industry practitioner, presents numerous real-world examples of AI applications in SEO. Highly recommended.</p>
              </div>
          </div>
          <div class="flex mb-2 md:flex-col md:mb-0">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={ImagePublication1} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
              <div>
                  <h3 class="text-xl font-bold md:mt-4 mb-2.5 text-gray-900 text-white">Unlock The Power of Generative AI in SEO by Andrew Bus</h3>
                  <p class="text-gray-200">This book, written by an industry practitioner, presents numerous real-world examples of AI applications in SEO. Highly recommended.</p>
              </div>
          </div>
          <div class="flex md:flex-col">
              <Image class="mr-4 w-auto h-36 md:w-full md:h-auto rounded-lg" src={ImagePublication1} alt="Unlock The Power of Generative AI in SEO by Andrew Bus" />
              <div>
                  <h3 class="text-xl font-bold md:mt-4 mb-2.5 text-gray-900 text-white">Unlock The Power of Generative AI in SEO by Andrew Bus</h3>
                  <p class="text-gray-200">This book, written by an industry practitioner, presents numerous real-world examples of AI applications in SEO. Highly recommended.</p>
              </div>
          </div>
      </div>
  </div>
</section>
