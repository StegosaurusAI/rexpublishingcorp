---
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getCanonicalPath, getPublishedArticles } from '../../lib/reviews';

const posts = await getPublishedArticles();
---

<BaseLayout title="Rex Publishing Blog" description="Publishing news, practical guidance, and market explainers from Rex Publishing.">
  <section class="bg-white ">
    <div class="py-8 px-4 mx-auto max-w-screen-xl lg:py-16 lg:px-6">
      <div class="mx-auto max-w-screen-sm text-center mb-8 lg:mb-16">
        <h1 class="mb-4 text-4xl tracking-tight font-extrabold text-gray-900 ">Rex Publishing Blog</h1>
        <p class="font-light text-gray-500 sm:text-xl ">Publishing news, practical guidance, and market explainers from the Rex Publishing desk.</p>
      </div>

      {posts.length ? (
        <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
          {posts.map((post) => (
            <article class="p-4 bg-white rounded-lg border border-gray-200 shadow-md ">
              {post.data.heroImage && (
                <a href={getCanonicalPath(post)}>
                  <img
                    class="mb-5 rounded-lg mx-auto h-[400px] w-full object-cover"
                    src={post.data.heroImage}
                    alt={post.data.description}
                    loading="lazy"
                  />
                </a>
              )}
              <span class="bg-purple-100 text-purple-800 text-xs font-semibold mr-2 px-2.5 py-0.5 rounded ">
                {post.data.pubDate.toLocaleDateString()}
              </span>
              <h2 class="my-2 text-2xl font-bold tracking-tight text-gray-900 ">
                <a href={getCanonicalPath(post)}>{post.data.title}</a>
              </h2>
              <p class="mb-4 font-light text-gray-500 ">{post.data.description}</p>
            </article>
          ))}
        </div>
      ) : (
        <div class="mx-auto max-w-2xl rounded-2xl border border-gray-200 bg-gray-50 p-8 text-center">
          <h2 class="mb-3 text-2xl font-bold text-gray-900">No blog posts published yet</h2>
          <p class="text-gray-600">
            New articles will appear here once they are published.
          </p>
        </div>
      )}
    </div>
  </section>
</BaseLayout>
