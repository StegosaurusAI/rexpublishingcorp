---
interface Props {
	title: string;
	description: string;
	type?: string,
	image?: string,
	canonical?: string,
	className?: string;
}

import SEOHead from  './SEOHead.astro'; 
import Header from './Header.astro'
import Footer from './Footer.astro'

const { title, description, type, image, canonical, className } = Astro.props;
const mainClases = className || "w-full";

---
<html lang="en">
	<head>
    <SEOHead 
      title={title} 
      description={description} 
      canonical={canonical}
      image={image}
    />
	</head>
	<body>
		<Header />
    <main class={mainClases}>
      <slot />
    </main>
		<Footer />
	</body>
</html>
