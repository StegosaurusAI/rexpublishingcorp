---
interface Props {
	title: string;
	description: string;
	type?: string,
	image?: string,
	canonical?: string,
	className?: string;
}

import SEOHead from  './SEOHead.astro'; 
import Header from './Header.astro'
import Footer from './Footer.astro'

const { title, description, type, image, canonical, className } = Astro.props;
const mainClases = className || "w-full";

---
<html lang="en">
	<head>
    <SEOHead 
      title={title} 
      description={description} 
      canonical={canonical}
      image={image}
    />
		<link rel="preconnect" href="https://www.googletagmanager.com/">
	</head>
	<body>
		<script type="text/partytown" src="https://www.googletagmanager.com/gtag/js?id=G-F7ND7BMD1L"></script>
		<script type="text/partytown">
		window.dataLayer = window.dataLayer || [];
		function gtag() { dataLayer.push(arguments); }
		gtag('js', new Date());
		gtag('config', 'G-F7ND7BMD1L');
		</script>

		<Header />
    <main class={mainClases}>
      <slot />
    </main>
		<Footer />
	</body>
</html>
